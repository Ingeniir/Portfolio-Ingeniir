---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page introuvable"
  description="Cette page n’existe pas ou a été déplacée."
>
  <section class="page-container py-28 text-center sm:py-36">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-forest-700">
      Erreur 404
    </p>

    <h1
      class="mt-4 text-5xl font-extrabold leading-[1.08] tracking-[-0.04em] text-charcoal sm:text-6xl"
    >
      Cette page n'existe pas.
    </h1>

    <p class="mt-6 text-lg leading-8 text-olive-gray">
      Le lien est peut-être incorrect ou la page a été déplacée.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-forest-700 px-6 py-3 font-semibold text-sand-50 transition-colors hover:bg-forest-800"
      >
        Retour à l'accueil
      </a>

      <a
        href="/projets"
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-charcoal/20 bg-sand-100 px-6 py-3 font-semibold text-charcoal transition-colors hover:border-forest-700 hover:text-forest-700"
      >
        Voir mes projets
      </a>
    </div>
  </section>
</Layout>
