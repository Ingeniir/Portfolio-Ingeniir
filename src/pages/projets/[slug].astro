---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout
  title={project.title}
  description={project.summary}
>
  <article>
    <header class="border-b border-sand-400/70 bg-sand-100/60">
      <div class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
        <a
          href="/projets"
          class="inline-flex font-semibold text-forest-700 transition-colors hover:text-forest-900"
        >
          <span class="mr-2" aria-hidden="true">←</span>
          Retour aux projets
        </a>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="text-sm font-bold text-forest-700">
            {project.category}
          </span>

          <span aria-hidden="true" class="text-sand-400">•</span>

          <span class="text-sm font-semibold text-olive-gray">
            {project.year}
          </span>

          <span
            class="rounded-full border border-sand-400 bg-sand-200 px-3 py-1 text-xs font-semibold text-olive-gray"
          >
            {project.status}
          </span>
        </div>

        <h1
          class="mt-6 text-4xl font-extrabold leading-[1.1] tracking-[-0.03em] text-charcoal sm:text-5xl"
        >
          {project.title}
        </h1>

        <p class="mt-6 text-lg leading-8 text-olive-gray">
          {project.description}
        </p>

        <ul
          class="mt-8 flex flex-wrap gap-2"
          aria-label="Technologies utilisées"
        >
          {
            project.technologies.map((technology) => (
              <li class="rounded-full bg-forest-700/10 px-3 py-1.5 text-sm font-semibold text-forest-800">
                {technology}
              </li>
            ))
          }
        </ul>

        {
          project.repositoryUrl && (
            <a
              href={project.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex min-h-12 items-center justify-center rounded-xl bg-forest-700 px-6 py-3 font-semibold text-sand-50 transition-colors hover:bg-forest-800"
            >
              Voir le code sur GitHub
              <span class="ml-2" aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
      <div class="space-y-14">
        {
          project.sections.map((section) => (
            <section>
              <h2 class="text-2xl font-extrabold tracking-tight text-charcoal sm:text-3xl">
                {section.title}
              </h2>

              <div class="mt-5 space-y-4 text-lg leading-8 text-olive-gray">
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>

              {section.bullets && (
                <ul class="mt-6 space-y-3">
                  {section.bullets.map((bullet) => (
                    <li class="flex gap-3 leading-7 text-olive-gray">
                      <span
                        class="mt-2.5 size-1.5 shrink-0 rounded-full bg-forest-700"
                        aria-hidden="true"
                      />
                      {bullet}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <div
        class="mt-16 flex flex-wrap items-center justify-between gap-6 rounded-3xl border border-sand-400 bg-sand-100 p-7 sm:p-8"
      >
        <p class="max-w-xl leading-7 text-olive-gray">
          Une question sur ce projet ou une opportunité de stage ?
          N'hésitez pas à me contacter.
        </p>

        <a
          href="/contact"
          class="inline-flex min-h-12 items-center justify-center rounded-xl bg-forest-700 px-6 py-3 font-semibold text-sand-50 transition-colors hover:bg-forest-800"
        >
          Me contacter
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>
</Layout>
