  description="Découvrez les projets de Cédric Hoareau en développement logiciel, analyse de données et intelligence artificielle."
>
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <p class="text-sm font-semibold uppercase tracking-widest text-forest-600">
      Mes réalisations
    </p>

    <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-6xl">
      Projets
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-olive-gray">
      Cette page présentera les projets qui accompagnent mon apprentissage
      en développement, analyse de données et intelligence artificielle.
    </p>
  </section>
</Layout>
