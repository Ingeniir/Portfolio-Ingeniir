---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact — Cédric Hoareau | Ingeniir"
  description="Contactez Cédric Hoareau pour échanger autour d'une opportunité de stage, d'un projet ou de l'intelligence artificielle."
>
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <p class="text-sm font-semibold uppercase tracking-widest text-forest-600">
      Échangeons
    </p>

    <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-6xl">
      Contact
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-olive-gray">
      Je recherche actuellement un stage dans le cadre de ma troisième année
      de licence MIASHS. Mes coordonnées et mes réseaux professionnels seront
      bientôt disponibles sur cette page.
    </p>
  </section>
</Layout>
