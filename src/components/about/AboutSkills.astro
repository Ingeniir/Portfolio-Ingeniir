---
import { learningSkills, skillGroups } from "../../data/skills";
---

<section
  id="competences"
  class="page-container py-20 sm:py-28"
  aria-labelledby="about-skills-title"
>
  <p class="text-sm font-bold uppercase tracking-[0.18em] text-forest-700">
    Mes compétences
  </p>

  <h2
    id="about-skills-title"
    class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-charcoal sm:text-5xl"
  >
    Ce que j'utilise et ce que j'apprends.
  </h2>

  <p class="mt-6 max-w-2xl text-lg leading-8 text-olive-gray">
    Je préfère présenter mes compétences par domaine plutôt que par
    pourcentage : certaines sont déjà bien maîtrisées, d'autres sont en
    cours d'approfondissement.
  </p>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      skillGroups.map((group) => (
        <article class="rounded-3xl border border-sand-400 bg-sand-100 p-7">
          <h3 class="text-xl font-extrabold text-charcoal">
            {group.title}
          </h3>

          <p class="mt-3 leading-7 text-olive-gray">
            {group.description}
          </p>

          <ul
            class="mt-6 flex flex-wrap gap-2"
            aria-label={`Compétences en ${group.title}`}
          >
            {group.skills.map((skill) => (
              <li class="rounded-full bg-forest-700/10 px-3 py-1.5 text-sm font-semibold text-forest-800">
                {skill}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div data-reveal class="mt-6 grid gap-6 md:grid-cols-2">
    <article class="rounded-3xl border border-dashed border-forest-700/30 bg-sand-100/60 p-7">
      <h3 class="text-xl font-extrabold text-charcoal">
        En cours d'apprentissage
      </h3>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Compétences en cours d'apprentissage">
        {
          learningSkills.map((skill) => (
            <li class="rounded-full border border-forest-700/25 px-3 py-1.5 text-sm font-semibold text-forest-800">
              {skill}
            </li>
          ))
        }
      </ul>
    </article>

    <article class="rounded-3xl border border-sand-400 bg-sand-100 p-7">
      <h3 class="text-xl font-extrabold text-charcoal">
        Bases académiques
      </h3>

      <ul class="mt-4 space-y-3">
        {
          [
            "Algèbre linéaire",
            "Analyse mathématique",
            "Bases de données",
            "Analyse de données",
            "Théorie des jeux",
          ].map((subject) => (
            <li class="flex gap-3 leading-7 text-olive-gray">
              <span
                class="mt-2.5 size-1.5 shrink-0 rounded-full bg-forest-700"
                aria-hidden="true"
              />
              {subject}
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>
