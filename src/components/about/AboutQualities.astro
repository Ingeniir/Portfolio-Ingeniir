---
import { qualities } from "../../data/about";
---

<section
  class="border-y border-sand-400/70 bg-forest-900 text-sand-50"
  aria-labelledby="qualities-title"
>
  <div class="page-container py-20 sm:py-24">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-sand-300">
      Ma façon de travailler
    </p>

    <h2
      id="qualities-title"
      class="mt-4 max-w-3xl text-3xl font-extrabold tracking-tight sm:text-4xl"
    >
      Trois qualités qui reviennent dans chacun de mes projets.
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        qualities.map((quality) => (
          <article class="rounded-2xl border border-sand-50/15 bg-sand-50/5 p-7">
            <h3 class="text-xl font-bold text-sand-50">
              {quality.title}
            </h3>

            <p class="mt-3 leading-7 text-sand-200">
              {quality.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
