---
import { skillGroups } from "../../data/skills";
---

<section
  id="competences"
  class="border-y border-sand-400/70 bg-forest-900 text-sand-50"
  aria-labelledby="skills-title"
>
  <div class="page-container py-20 sm:py-28">
    <div data-reveal class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <p
          class="text-sm font-bold uppercase tracking-[0.18em] text-sand-300"
        >
          Mes compétences
        </p>

        <h2
          id="skills-title"
          class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl"
        >
          Une base polyvalente, en évolution constante.
        </h2>

        <p class="mt-6 max-w-xl text-lg leading-8 text-sand-200">
          Mon parcours MIASHS me permet de relier programmation, données et
          mathématiques. Je continue actuellement à approfondir le machine
          learning, les statistiques et les probabilités.
        </p>
      </div>

      <div class="grid gap-5">
        {
          skillGroups.map((group) => (
            <article class="rounded-2xl border border-sand-50/15 bg-sand-50/5 p-6">
              <h3 class="text-xl font-bold text-sand-50">
                {group.title}
              </h3>

              <p class="mt-2 leading-7 text-sand-200">
                {group.description}
              </p>

              <ul
                class="mt-5 flex flex-wrap gap-2"
                aria-label={`Compétences en ${group.title}`}
              >
                {group.skills.map((skill) => (
                  <li class="rounded-full border border-sand-50/15 bg-sand-50/10 px-3 py-1.5 text-sm font-semibold text-sand-100">
                    {skill}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
