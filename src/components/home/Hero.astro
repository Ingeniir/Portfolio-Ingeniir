<section
  class="relative overflow-hidden"
  aria-labelledby="hero-title"
>
  <div
    class="page-container grid min-w-0 items-center gap-12 py-16 sm:py-24 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] lg:gap-16 lg:py-32"
  >
    <div class="min-w-0">
      <p
        class="inline-flex max-w-full items-center gap-2 rounded-full border border-forest-600/20 bg-sand-100 px-3 py-2 text-xs font-semibold text-forest-700 sm:px-4 sm:text-sm"
      >
        <span
          class="size-2 shrink-0 rounded-full bg-forest-600"
          aria-hidden="true"
        ></span>

        <span>À la recherche d'un stage de L3</span>
      </p>

      <p class="mt-7 text-base font-semibold text-forest-700 sm:mt-8 sm:text-lg">
        Bonjour, moi c'est Cédric.
      </p>

      <h1 id="hero-title" class="display-title mt-4 text-charcoal">
        Je transforme progressivement les
        <span class="text-forest-700">données</span>
        et les idées en outils utiles.
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-7 text-olive-gray sm:mt-7 sm:text-lg sm:leading-8">
        Étudiant en L3 MIASHS à l'Université de La Réunion, je développe
        mes compétences en programmation, analyse de données et intelligence
        artificielle, un projet à la fois.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:flex-wrap sm:gap-4">
        <a
          href="/projets"
          class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-forest-700 px-5 py-3 text-center font-semibold text-sand-50 transition-colors hover:bg-forest-800 sm:w-auto sm:px-6"
        >
          Découvrir mes projets
        </a>

        <a
          href="/documents/CV-Cedric-Hoareau.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 w-full items-center justify-center rounded-xl border border-charcoal/20 bg-sand-100 px-5 py-3 text-center font-semibold text-charcoal transition-colors hover:border-forest-700 hover:text-forest-700 sm:w-auto sm:px-6"
        >
          Consulter mon CV
          <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>

      <ul
        class="mt-8 flex flex-wrap gap-2 text-sm font-medium text-olive-gray sm:mt-10"
        aria-label="Informations principales"
      >
        <li class="rounded-full border border-sand-400/80 bg-sand-100/50 px-3 py-1.5">
          Saint-Denis, La Réunion
        </li>

        <li class="rounded-full border border-sand-400/80 bg-sand-100/50 px-3 py-1.5">
          L3 MIASHS
        </li>

        <li class="rounded-full border border-sand-400/80 bg-sand-100/50 px-3 py-1.5">
          Data, IA et développement
        </li>
      </ul>
    </div>

    <div
      class="relative mx-auto w-full min-w-0 max-w-68 sm:max-w-sm lg:justify-self-end"
    >
      <div
        class="absolute -inset-3 -rotate-3 rounded-[1.75rem] bg-forest-700/10 sm:-inset-5 sm:rounded-4xl"
        aria-hidden="true"
      ></div>

      <figure
        class="relative overflow-hidden rounded-[1.75rem] border border-sand-400 bg-sand-100 p-2.5 shadow-[0_20px_60px_rgba(23,25,20,0.12)] sm:rounded-4xl sm:p-3"
      >
        <img
          src="/images/cedric-hoareau.webp"
          alt="Portrait professionnel de Cédric Hoareau"
          width="600"
          height="750"
          class="aspect-4/5 w-full rounded-[1.25rem] object-cover sm:rounded-[1.4rem]"
          fetchpriority="high"
        />

        <figcaption
          class="flex min-w-0 flex-col items-start gap-3 px-2 pb-1 pt-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
        >
          <div class="min-w-0">
            <p class="font-bold text-charcoal">Cédric Hoareau</p>

            <p class="mt-1 text-sm leading-6 text-olive-gray">
              Étudiant en informatique et science des données
            </p>
          </div>

          <span
            class="shrink-0 rounded-full bg-forest-700 px-3 py-1 text-xs font-bold text-sand-50"
          >
            Ingeniir
          </span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
