<section
  class="relative overflow-hidden"
  aria-labelledby="hero-title"
>
  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 sm:py-28 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16 lg:py-32"
  >
    <div>
      <p
        class="inline-flex items-center gap-2 rounded-full border border-forest-600/20 bg-sand-100 px-4 py-2 text-sm font-semibold text-forest-700"
      >
        <span
          class="size-2 rounded-full bg-forest-600"
          aria-hidden="true"
        ></span>

        À la recherche d'un stage de L3
      </p>

      <p class="mt-8 text-lg font-semibold text-forest-700">
        Bonjour, moi c'est Cédric.
      </p>

      <h1
        id="hero-title"
        class="mt-4 max-w-4xl text-5xl font-extrabold leading-[1.08] tracking-[-0.04em] text-charcoal sm:text-6xl lg:text-7xl"
      >
        Je transforme progressivement les{" "}
        <span class="text-forest-700">données</span>
        {" "}
        et les idées en outils utiles.
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-8 text-olive-gray">
        Étudiant en L3 MIASHS à l'Université de La Réunion, je développe
        mes compétences en programmation, <b>analyse de données</b> et <b>intelligence
        artificielle</b>, un projet à la fois.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/projets"
          class="inline-flex min-h-12 items-center justify-center rounded-xl bg-forest-700 px-6 py-3 font-semibold text-sand-50 transition-colors hover:bg-forest-800"
        >
          Découvrir mes projets
        </a>

        <a
          href="/documents/CV-Cedric-Hoareau.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center justify-center rounded-xl border border-charcoal/20 bg-sand-100 px-6 py-3 font-semibold text-charcoal transition-colors hover:border-forest-700 hover:text-forest-700"
        >
          Consulter mon CV
          <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>

      <ul
        class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-olive-gray"
        aria-label="Informations principales"
      >
        <li>Saint-Denis, La Réunion</li>
        <li aria-hidden="true">•</li>
        <li>L3 MIASHS</li>
        <li aria-hidden="true">•</li>
        <li>Data, IA et développement</li>
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-sm lg:justify-self-end">
      <div
        class="absolute -inset-5 -rotate-3 rounded-[2rem] bg-forest-700/10"
        aria-hidden="true"
      ></div>

      <figure
        class="relative overflow-hidden rounded-[2rem] border border-sand-400 bg-sand-100 p-3 shadow-[0_20px_60px_rgba(23,25,20,0.12)]"
      >
        <img
          src="/images/cedric-hoareau.webp"
          alt="Portrait professionnel de Cédric Hoareau"
          width="600"
          height="750"
          class="aspect-[4/5] w-full rounded-[1.4rem] object-cover"
          fetchpriority="high"
        />

        <figcaption
          class="flex items-center justify-between gap-4 px-2 pb-1 pt-4"
        >
          <div>
            <p class="font-bold text-charcoal">Cédric Hoareau</p>
            <p class="mt-1 text-sm text-olive-gray">
              Étudiant en informatique et science des données
            </p>
          </div>

          <span
            class="shrink-0 rounded-full bg-forest-700 px-3 py-1 text-xs font-bold text-sand-50"
          >
            Ingeniir
          </span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
